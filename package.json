{
  "name": "opsora",
  "private": true,
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "cd apps/api && npx drizzle-kit generate",
    "db:migrate": "cd apps/api && npx drizzle-kit migrate",
    "db:studio": "cd apps/api && npx drizzle-kit studio",
    "db:seed": "cd apps/api && npx tsx src/lib/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "patch-package": "^8.0.1",
    "playwright": "^1.61.1",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "puppeteer": "^25.2.0"
  }
}
